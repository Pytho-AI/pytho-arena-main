{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytho.local/schemas/dagor-frame-chunk-v1.schema.json",
  "title": "Pytho Dagor frame chunk envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "runId",
    "sequence",
    "chunkIndex",
    "chunkCount",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "frame_chunk" },
    "runId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "chunkIndex": { "type": "integer", "minimum": 0 },
    "chunkCount": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "payload": { "type": "string" }
  }
}
